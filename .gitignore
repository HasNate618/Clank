# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/

# Vendored upstream repositories. Each has its own .git and is 400+ MB;
# fetch them per research/*.md rather than committing them.
spike/*/vendor/
spike/vendor/

# Model weights (ONNX, 40–140 MB each).
spike/*/weights/

# Per-tick run streams. Summaries (*.json) are kept as evidence.
*.jsonl

# Transient logs
*.log

# Local editor / OS noise
.DS_Store
.swp

# Isolated worktrees
.worktrees/

# Per-tick run logs. Aggregated summaries (*_measurements.json, summary.json)
# are committed instead; these regenerate by re-running the spike.
spike/*/logs/*.csv

# Regenerable captures and build outputs
spike/e2/frames/
spike/e1/include/
spike/e1/xr_view_probe

# Walkthrough media: large, local-only fixtures. The clip is re-downloaded, never
# committed; only the derived text (subtitle timings, traces) is.
*.mp4
*.mp3

# Machine-specific config (absolute paths, Steam shortcut id)
config.toml
# ...and its local backups
config.toml.*

# weston-screenshooter ignores its output argument and writes here
wayland-screenshot-*.png

# Locally built depth-stream layer
spike/e5/build/

# nix build .#monado leaves this behind
/result

# Intermediate PPM/PGM frames; the PNGs beside them are the evidence
research/evidence/depth-stream/*.ppm
research/evidence/depth-stream/*.pgm

# Heavy evidence stays on disk, never in git: a single RenderDoc capture is 400 MB and
# GitHub refuses files over 100 MB. Derive the PNGs instead and commit those.
research/evidence/**/*.rdc
research/evidence/**/*.npy
research/evidence/**/*.ppm
research/evidence/**/*.pgm
*.mp4
*.mp3
