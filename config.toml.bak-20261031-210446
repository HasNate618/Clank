[body]
# Third-person MuJoCo view beside the game cam. Needs the SONIC venv + weights,
# so it is off in a bare checkout. `autostart` starts it with the dashboard.
enabled = true
autostart = true
python = "spike/e3/.venv/bin/python"
script = "spike/wbc/body_view.py"
fps = 10
width = 560
height = 420
# Standing hold, not the verb reel: the FOV A/B compares two captures, which is only
# meaningful if the body is in the same pose for both.
reel = false

# The robot's heading in the virtual room, degrees, positive toward its left.
# The desk needs a 90 deg left turn, and this body cannot twist that far: a commanded
# left look reaches only -28.6 deg (measured), against +54.3 right. So the heading is
# chosen rather than walked. The arms are unaffected - the hand stays at the same place
# in the camera's frame at any offset, verified to 1e-9 - and 0.0 changes nothing.
yaw_offset_deg = 90.0

# Declared headset field of view, FULL angles in degrees (both or neither).
# Undeclared (0/0) leaves the remote driver's own default in force - that is what every
# earlier run used. 110 x 78 is a plausible wide headset; whether this build honours the
# declaration is the measurement in research/fov-declaration.md.
fov_h_deg = 110.0
fov_v_deg = 110.0
